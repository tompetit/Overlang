// Fuzzing finds both wrong `ensures` clauses (tests/fuzz.rs).
type Tree = Leaf | Node(left: Tree, value: Int, right: Tree)

fn clamp(x: Int) -> Int
  ensures result >= 0
{
  if x > 100 { 100 } else { x }
}

fn size(t: Tree) -> Int {
  match t {
    Leaf => 0,
    Node(l, _, r) => size(l) + 1 + size(r),
  }
}

// Wrong for trees of three or more nodes; shrinks to exactly three.
fn small(t: Tree) -> Int
  ensures result < 3
{
  size(t)
}

fn main() -> Unit !io {
  println(show(clamp(150)));
  println(show(small(Node(Leaf, 1, Leaf))));
}

test clamp_high {
  assert_eq(clamp(150), 100);
  assert_eq(small(Leaf), 0);
}
