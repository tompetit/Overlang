// Polymorphic recursion: every call needs a bigger instance of `depth`.
fn depth[T](x: T, n: Int) -> Int {
  if n == 0 { 0 } else { 1 + depth((x, x), n - 1) }
}

// A type that mentions itself at a bigger argument.
type Nest[T] = Leaf(v: T) | Deep(n: Nest[List[T]])

// The same through another function: ping[T] -> pong[List[T]] -> ping[List[T]].
fn ping[T](x: T, n: Int) -> Int {
  if n == 0 { 0 } else { pong([x], n - 1) }
}

fn pong[T](x: T, n: Int) -> Int {
  ping(x, n)
}

// Regular recursion is fine: the arguments come back unchanged or swapped.
type Tree[T] = Node(v: T, kids: List[Tree[T]])

fn swap[A, B](a: A, b: B, n: Int) -> Int {
  if n == 0 { 0 } else { swap(b, a, n - 1) }
}

fn main() -> Unit !io {
  let t: Tree[Int] = Node(1, []);
  println(show(depth(1, 3) + ping(1, 2) + swap(1, "a", 2)));
  println(show(t));
}
