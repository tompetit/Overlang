// Constraints on type parameters (section 3) are checked at every
// instantiation, and `ov check` reports them like any other type error.
fn lt[T](a: T, b: T) -> Bool {
  a < b
}

fn srt[T](xs: List[T]) -> List[T] {
  sort(xs)
}

type Box[T] = { v: T }

fn same[T](a: Box[T], b: Box[T]) -> Bool {
  a == b
}

fn u[T](xs: List[T]) -> List[T] {
  unique(xs)
}

// Not reachable from main: still checked.
fn helper() -> Bool {
  lt([1], [2])
}

fn main() -> Unit !io {
  let f = |x: Int| x;
  println(show(lt((1, 2), (1, 3))));
  println(show(srt([true, false])));
  println(show(same(Box { v: f }, Box { v: f })));
  println(show(u([1.5, 1.5])));
  println(show(lt(1, 2)));
}

test instantiates_too {
  assert(srt([1.5, 0.5]) == [0.5, 1.5]);
  assert(!lt(Some(1), None));
}
