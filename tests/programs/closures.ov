fn make_adder(n: Int) -> fn(Int) -> Int {
  |x| x + n
}

fn compose[A, B, C](f: fn(A) -> B, g: fn(B) -> C) -> fn(A) -> C {
  |x| g(f(x))
}

fn counter_labels(prefix: Str, xs: List[Int]) -> List[Str] {
  let sep = ": ";
  map(xs, |x| {
    let doubled = x * 2;
    let fmt = |y: Int| prefix ++ sep ++ show(y) ++ "/" ++ show(doubled);
    fmt(x)
  })
}

fn main() -> Unit !io {
  let add5 = make_adder(5);
  println(show(add5(10)));
  let base = 100;
  let outer = |a: Int| {
    let mid = a * 10;
    let inner = |b: Int| base + mid + b;
    inner(1)
  };
  println(show(outer(2)));
  let f = compose(make_adder(1), |n| show(n) ++ "!");
  println(f(41));
  println(join(counter_labels("n", [1, 2, 3]), ", "));
  let fs = map(range(1, 4), |k| |x: Int| x * k);
  println(show(map(fs, |g| g(10))));
  let total = fold([1, 2, 3, 4], 0, |acc, x| acc + add5(x));
  println(show(total));
}
