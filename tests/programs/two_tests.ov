fn clamp(x: Int, lo: Int, hi: Int) -> Int
  requires lo <= hi
  ensures result >= lo && result <= hi
{
  if x < lo {
    return lo;
  }
  min(x, hi)
}

fn main() -> Unit !io {
  println(show(clamp(15, 0, 10)));
}

test clamp_inside {
  assert_eq(clamp(5, 0, 10), 5);
}

test clamp_edges {
  assert(clamp(-3, 0, 10) == 0);
  assert_eq(clamp(99, 0, 10), 10);
}
