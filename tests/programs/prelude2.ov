type P = { name: Str, n: Int }

fn half(n: Int) -> Option[Int] { if n % 2 == 0 { Some(n / 2) } else { None } }

fn main() -> Unit !io {
  let xs = [1, 2, 3, 4, 5, 6];
  println(show(count(xs, |x| x > 2)));
  println(show(filter_map(xs, half)));
  println(show(filter_map(["1", "x", "3"], parse_int)));
  println(show(take_while(xs, |x| x < 4)));
  println(show(drop_while(xs, |x| x < 4)));
  println(show(take_while([], |x: Int| x < 4)));
  println(show(drop_while(xs, |x| x < 100)));
  println(show(max_by(["bb", "a", "cc", "d"], |s| str_len(s))));
  println(show(min_by(["bb", "a", "cc", "d"], |s| str_len(s))));
  println(show(max_by([], |x: Int| x)));
  let ps = [P { name: "b", n: 1 }, P { name: "a", n: 2 }, P { name: "b", n: 3 }, P { name: "a", n: 4 }, P { name: "B", n: 5 }];
  println(show(sort_by_str(ps, |p| p.name).map(|p| p.n)));
  println(show(sort_by_str(["pear", "fig", "apple"], |s| s)));
  println(show(split_once("k=v=w", "=")));
  println(show(split_once("kv", "=")));
  println(show(split_once("a, b", ", ")));
  println(show(str_index_of("h\u{e9}llo wor", "wor")));
  println(show(str_index_of("abc", "z")));
  println(show(str_index_of("abc", "")));
  println(show(lines("a\nb\n")));
  println(show(lines("a\n\nb")));
  println(show(lines("a\n\n")));
  println(show(lines("")));
  println(show(map(["7", "a", "Z", " ", "", "\t", "_"], |c| [is_digit(c), is_alpha(c), is_alnum(c), is_space(c), is_upper(c), is_lower(c)])));
  print("no newline");
  flush();
  println("");
}
