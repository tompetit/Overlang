type Shape = Circle(r: Float) | Rect(w: Float, h: Float) | Empty

fn area(s: Shape) -> Float {
  match s {
    Circle(r) => 3.0 * r * r,
    Rect(w, h) => w * h,
    Empty => 0.0,
  }
}

fn main() -> Unit !io {
  let shapes = [Circle(1.0), Rect(2.0, 3.0), Empty];
  for s in shapes {
    println(show(area(s)));
  }
}
