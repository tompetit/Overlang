fn fib(n: Int) -> Int
  requires n >= 0
  ensures result >= 0
{
  let mut a = 0;
  let mut b = 1;
  let mut i = 0;
  while i < n {
    let t = a + b;
    a = b;
    b = t;
    i = i + 1;
  }
  a
}

fn count_evens(xs: List[Int]) -> Int {
  let mut c = 0;
  for x in xs {
    if x % 2 == 0 {
      c = c + 1;
    }
  }
  c
}

fn main() -> Unit !io {
  println(show(fib(30)));
  println(show(count_evens(range(0, 11))));
  println(show(div_floor(-7, 2)) ++ " " ++ show(-7 / 2));
}
