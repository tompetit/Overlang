type V = A | B | C | D | E | F | G | H
fn f(t: (V, V, V, V, V, V, V, V)) -> Int {
  match t {
    (A, _, _, _, _, _, _, _) => 0,
    (B, _, _, _, _, _, _, _) => 0,
    (C, _, _, _, _, _, _, _) => 0,
    (D, _, _, _, _, _, _, _) => 0,
    (E, _, _, _, _, _, _, _) => 0,
    (F, _, _, _, _, _, _, _) => 0,
    (G, _, _, _, _, _, _, _) => 0,
    (_, A, _, _, _, _, _, _) => 1,
    (_, B, _, _, _, _, _, _) => 1,
    (_, C, _, _, _, _, _, _) => 1,
    (_, D, _, _, _, _, _, _) => 1,
    (_, E, _, _, _, _, _, _) => 1,
    (_, F, _, _, _, _, _, _) => 1,
    (_, G, _, _, _, _, _, _) => 1,
    (_, _, A, _, _, _, _, _) => 2,
    (_, _, B, _, _, _, _, _) => 2,
    (_, _, C, _, _, _, _, _) => 2,
    (_, _, D, _, _, _, _, _) => 2,
    (_, _, E, _, _, _, _, _) => 2,
    (_, _, F, _, _, _, _, _) => 2,
    (_, _, G, _, _, _, _, _) => 2,
    (_, _, _, A, _, _, _, _) => 3,
    (_, _, _, B, _, _, _, _) => 3,
    (_, _, _, C, _, _, _, _) => 3,
    (_, _, _, D, _, _, _, _) => 3,
    (_, _, _, E, _, _, _, _) => 3,
    (_, _, _, F, _, _, _, _) => 3,
    (_, _, _, G, _, _, _, _) => 3,
    (_, _, _, _, A, _, _, _) => 4,
    (_, _, _, _, B, _, _, _) => 4,
    (_, _, _, _, C, _, _, _) => 4,
    (_, _, _, _, D, _, _, _) => 4,
    (_, _, _, _, E, _, _, _) => 4,
    (_, _, _, _, F, _, _, _) => 4,
    (_, _, _, _, G, _, _, _) => 4,
    (_, _, _, _, _, A, _, _) => 5,
    (_, _, _, _, _, B, _, _) => 5,
    (_, _, _, _, _, C, _, _) => 5,
    (_, _, _, _, _, D, _, _) => 5,
    (_, _, _, _, _, E, _, _) => 5,
    (_, _, _, _, _, F, _, _) => 5,
    (_, _, _, _, _, G, _, _) => 5,
    (_, _, _, _, _, _, A, _) => 6,
    (_, _, _, _, _, _, B, _) => 6,
    (_, _, _, _, _, _, C, _) => 6,
    (_, _, _, _, _, _, D, _) => 6,
    (_, _, _, _, _, _, E, _) => 6,
    (_, _, _, _, _, _, F, _) => 6,
    (_, _, _, _, _, _, G, _) => 6,
    (_, _, _, _, _, _, _, A) => 7,
    (_, _, _, _, _, _, _, B) => 7,
    (_, _, _, _, _, _, _, C) => 7,
    (_, _, _, _, _, _, _, D) => 7,
    (_, _, _, _, _, _, _, E) => 7,
    (_, _, _, _, _, _, _, F) => 7,
    (_, _, _, _, _, _, _, G) => 7,
    (H, H, H, H, H, H, H, H) => 99,
  }
}
fn main() -> Unit !io {
  println(show(f((A, A, A, A, A, A, A, A))));
}
