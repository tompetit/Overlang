fn word_counts(words: List[Str]) -> Map[Str, Int] {
  fold(words, map_new(), |m, w| map_set(m, w, unwrap_or(map_get(m, w), 0) + 1))
}

fn main() -> Unit !io {
  let m = word_counts(split("b a c a b a", " "));
  println(show(m));
  println(show(map_keys(m)));
  println(show(map_values(m)));
  println(show(map_len(m)));
  println(show(m["a"]));
  println(show(map_get(m, "z")));
  println(show(map_contains(m, "c")));
  let m2 = map_remove(m, "b");
  println(show(map_to_list(m2)));
  println(show(m2 == map_from_list([("c", 1), ("a", 3)])));
  let s = set_from_list([3, 1, 3, 2, 1]);
  println(show(s));
  println(show(set_len(s)));
  println(show(set_contains(s, 2)));
  println(show(set_to_list(set_remove(set_add(s, 9), 1))));
  println(show(sort(set_to_list(s))));
  println(show(unique([true, false, true])));
  println(show(sort_by(["ccc", "a", "bb"], |w| str_len(w))));
  println(show(min_of([4, 2, 9])) ++ " " ++ show(max_of(["x", "yy", "z"])) ++ " " ++ show(min_of([2.5, 0.5])));
  let flags = map_set(map_set(map_new(), true, "yes"), false, "no");
  println(show(map_get(flags, false)));
}
